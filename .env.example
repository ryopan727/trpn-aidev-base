# Copy to .env. Use different values for each worktree; never commit real secrets.
COMPOSE_PROJECT_NAME=trpn-aidev-local
API_PORT=8000
DB_NAME=tasks
DB_USER=tasks_dev
DB_PASSWORD=replace-with-local-dev-password
TEST_DB_NAME=tasks_test
TEST_DB_USER=tasks_test
TEST_DB_PASSWORD=replace-with-different-test-password
LOG_LEVEL=INFO
